{
  "name": "fast-cookie-read",
  "version": "2.0.7",
  "description": "Cookie library for browsers: read, set and delete cookies with a cached parser, TypeScript types and no dependencies",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.min.js",
    "index.d.ts"
  ],
  "scripts": {
    "test": "jest",
    "lint": "eslint .",
    "build": "npm run minify",
    "minify": "terser index.js -c -m -o index.min.js",
    "prepare": "npm run build",
    "test:types": "tsc -p tests/types/tsconfig.bundler.json && tsc -p tests/types/tsconfig.node16.json"
  },
  "keywords": [
    "cookie",
    "cookies",
    "document.cookie",
    "get-cookie",
    "set-cookie",
    "read-cookie",
    "delete-cookie",
    "browser",
    "ssr",
    "typescript",
    "js-cookie-alternative",
    "lightweight",
    "zero-dependencies"
  ],
  "author": "Nithin Murali <nithintecharch@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nithin-murali-arch/fast-cookie-read"
  },
  "bugs": {
    "url": "https://github.com/nithin-murali-arch/fast-cookie-read/issues"
  },
  "homepage": "https://github.com/nithin-murali-arch/fast-cookie-read#readme",
  "engines": {
    "node": ">=16.0.0"
  },
  "browser": {
    "index.js": "./index.min.js"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "terser": "^5.29.2",
    "typescript": "^7.0.2"
  },
  "jest": {
    "setupFiles": [
      "./jest.setup.js"
    ],
    "testEnvironment": "node"
  },
  "publishConfig": {
    "access": "public"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/nithin-murali-arch"
  },
  "unpkg": "index.min.js",
  "jsdelivr": "index.min.js"
}
